# Copy to .env for LOCAL runs only (.env is git-ignored). In GitHub, set these
# as repository secrets instead: Settings → Secrets and variables → Actions.

# Required for email
GMAIL_ADDRESS=vahehakobyanv@gmail.com
GMAIL_APP_PASSWORD=            # 16-character Google App Password, NOT your normal password

# Optional: comma-separated recipients (default: config/settings.yaml → email.recipients)
EMAIL_TO=

# Optional free data sources (the app works without them)
BESTBUY_API_KEY=               # https://developer.bestbuy.com
EBAY_CLIENT_ID=                # https://developer.ebay.com (Production keyset → App ID)
EBAY_CLIENT_SECRET=            # (Production keyset → Cert ID)

# Optional: exchangerate-api.com key (fallback FX source; CBA.am is used first, no key)
EXCHANGE_RATE_API_KEY=

# Optional: Telegram alerts (create a bot with @BotFather, then run
#   python -m app.main telegram-setup   to find your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, unused by the core system (reserved for future AI summaries)
OPTIONAL_AI_API_KEY=
